      "memcpy": {
        "patterns": ["\\bmemcpy\\s*\\("]
      },
      "memmove": {
        "patterns": ["\\bmemmove\\s*\\("]
      },
      "array_write": {
        "patterns": ["\\b[A-Za-z_][A-Za-z0-9_]*\\s*\\[[^\\]\\n]+\\]\\s*="],
        "slice_patterns": [
          "\\b[A-Za-z_][A-Za-z0-9_]*\\s*\\[[^\\]\\n]+\\]\\s*=",
